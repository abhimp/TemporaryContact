# Temporary Contacts behind nginx (TLS termination + reverse proxy).
# Assumes the app runs with network.reverse_proxy: true on 127.0.0.1:5232.
# Get certs with: certbot --nginx -d contacts.example.com

server {
    listen 80;
    server_name contacts.example.com;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name contacts.example.com;

    ssl_certificate     /etc/letsencrypt/live/contacts.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/contacts.example.com/privkey.pem;

    client_max_body_size 25m;   # room for contact photos

    location / {
        proxy_pass http://127.0.0.1:5232;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
